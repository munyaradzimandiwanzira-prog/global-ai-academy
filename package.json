{
  "name": "global-ai-academy",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Global AI Academy — hands-on AI & software engineering school for Zimbabwean learners.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "npm run build && vite preview",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply global_ai_academy --local",
    "db:migrate:remote": "wrangler d1 migrations apply global_ai_academy --remote",
    "cf-typegen": "wrangler types --env-interface Env worker/env.d.ts",
    "icons": "python3 scripts/build-icons.py"
  },
  "dependencies": {
    "@codemirror/lang-cpp": "6.0.3",
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-html": "6.4.9",
