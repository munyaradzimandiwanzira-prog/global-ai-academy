{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["node", "@cloudflare/workers-types"],
    "baseUrl": ".",
    "paths": { "@shared/*": ["./shared/*"], "@/*": ["./src/*"] }
  },
  "include": ["vite.config.ts", "plugins/**/*.ts", "tests/**/*.ts", "vitest.config.ts", "worker/env.d.ts"]
}
