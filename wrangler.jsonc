{
  // Global AI Academy — Cloudflare Worker (API) + static assets (React SPA)
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "global-ai-academy",
  "main": "./worker/index.ts",
  "compatibility_date": "2025-09-15",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Public address: skurulearning.com (www redirects to it). The *.workers.dev address and
  // per-version preview URLs are switched off so the account's sub-name never appears publicly.
  "routes": [
    { "pattern": "skurulearning.com", "custom_domain": true },
    { "pattern": "www.skurulearning.com", "custom_domain": true }
  ],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    // SPA routing: unknown paths serve index.html; /api/* and the preview sandbox always hit the worker.
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/sandbox/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "global_ai_academy",
      // Production database (Cloudflare D1, Western Europe — closest D1 region to Harare).
      "database_id": "b30bb6a2-2131-427d-b8e8-8d2137c05b07",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "APP_NAME": "Global AI Academy",
    "APP_URL": "https://skurulearning.com",
    "OPENAI_MODEL": "gpt-5.4-mini",
    // Zuva, the tutor agent: tool calling, memory and sub-agents. Dictation uses the transcription model.
    "ZUVA_MODEL": "gpt-5.5",
    "ZUVA_FAST_MODEL": "gpt-5.4-mini",
    "ZUVA_TRANSCRIBE_MODEL": "gpt-transcribe",
    // Must be a sender verified in Brevo. munyaradzimandiwanzira@gmail.com is verified today; switch to an
    // address on your own domain once it is authenticated in Brevo (better inbox delivery).
    "EMAIL_FROM": "Global AI Academy <admin@skurulearning.com>",
    "JUDGE0_URL": ""
  }
  // Secrets (set with `npx wrangler secret put NAME`, or in .dev.vars locally):
  //   ADMIN_EMAILS          – comma-separated emails promoted to admin on sign-up (kept secret, never in Git)
  //   OPENAI_API_KEY        – required for AI features
  //   BREVO_API_KEY         – optional, sends verification / reset emails
  //   PAYNOW_INTEGRATION_ID – optional, Paynow Zimbabwe (EcoCash / OneMoney / cards)
  //   PAYNOW_INTEGRATION_KEY
  //   JUDGE0_API_KEY        – optional, server-side runner for Java/Kotlin/C++/PHP/Swift
}
